{
  "manifest_version": 3,
  "name": "Open Soundcraft MIDI",
  "version": "0.5.0",
  "description": "Open-source MIDI control and bidirectional feedback for Soundcraft Ui mixer web interfaces.",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "offscreen"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open / close Open Soundcraft MIDI sidebar"
  },
  "side_panel": {
    "default_path": "controller/controller.html"
  },
  "version_name": "0.5.0-beta.14"
}
